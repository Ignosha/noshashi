# Dependencies
node_modules/
site/node_modules/

# Build output
dist/
dist-demo/
site/.next/
src-tauri/target/
src-tauri/gen/

# Secrets — never commit. Paste credentials into the hosting provider's
# own settings, not into this repo.
.env
.env.*
!.env.example
site/.env
site/.env.*
!site/.env.example
*.pem
*.key
*.p12

# Tauri build output. Rebuilt by CI (.github/workflows/release.yml), so
# there is no reason to carry it in history.
release/

# NOTE: site/download/ is deliberately NOT ignored. That directory is not
# build output — it is the content noshashi.app actually serves, and the
# macOS .dmg is linked directly from the download section of
# site/index.html. Ignoring it breaks the live download on any deploy that
# publishes from this repository.
#
# The tradeoff is ~3.4 MB of binary per release carried in history. Once
# there is a GitHub remote, move installers to GitHub Releases and point
# the site at those URLs instead — the release workflow already builds and
# uploads all four targets.

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Build caches
*.tsbuildinfo

# Vite cache
.vite/
