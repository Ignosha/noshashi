# Copy to .env.local to point a local build at a different Supabase project.
#
# Both are optional. src/lib/supabase/client.ts falls back to the production
# project when they are unset, which is what release builds depend on — the
# release workflow supplies neither, so removing that fallback would break
# every packaged build.
#
# The publishable key is not a secret. It grants nothing on its own: every
# table is behind row level security, and the service-role key that would
# bypass it exists only inside Edge Functions. The service-role key must never
# appear in this file or anywhere else in this repository.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Changing VITE_SUPABASE_URL is not enough on its own.
#
# The Tauri Content Security Policy allowlists the Supabase origin explicitly,
# in both src-tauri/tauri.conf.json and src-tauri/tauri.demo.conf.json, once
# over https and once over wss. That policy is compiled into the installer, so
# a new origin here without matching edits there works in `npm run tauri:dev`
# and blocks every request in the built application.
#
# src/lib/supabase/__tests__/client-csp.test.ts fails when the three disagree.

# "demo" builds the limited early-release artefact. See src/lib/edition.ts.
# VITE_NOSHASHI_EDITION=demo

# Website checkout placeholders. Replace only in Vercel's environment settings;
# never commit a real Stripe secret or put it in browser code.
STRIPE_SECRET_KEY=sk_test_placeholder_replace_in_vercel
PUBLIC_SITE_URL=https://noshashi.app

# ─────────────────────────────────────────────────────────────────────
# Website checkout (Vercel environment only — never commit a real key)
# ─────────────────────────────────────────────────────────────────────
#
# STRIPE_SECRET_KEY and STRIPE_PRO_PRICE_ID must come from the SAME
# Stripe mode. A price ID is mode-scoped: a live key cannot see a test
# price, and the failure looks like a generic checkout error rather than
# a configuration problem. GET /api/stripe-status reports which mode the
# key is in and whether the price exists, without revealing the key.
STRIPE_PRO_PRICE_ID=price_replace_with_a_price_from_the_same_mode

# ─────────────────────────────────────────────────────────────────────
# Contact form delivery
# ─────────────────────────────────────────────────────────────────────
#
# Both channels fire when both are set, and either one succeeding counts
# as delivered. With neither set, /api/contact returns 503 and the page
# shows the direct address instead of accepting a message nobody will
# receive. GET /api/contact-status reports what is configured.
#
# Email, via Resend (https://resend.com):
#   1. Create an account and verify the domain you send FROM.
#   2. Create an API key; it begins re_.
#   3. Set the three variables below in the Vercel project.
#
# Replies go to the person who filled in the form: reply_to is set to
# their address, so answering the forwarded mail from an ordinary inbox
# reaches them directly. There is nothing else to log into.
RESEND_API_KEY=re_replace_in_vercel
# Where enquiries land. A comma-separated list gets a copy to each.
CONTACT_TO=you@example.com
# Must be on a domain verified in Resend, or sending is refused.
CONTACT_FROM=NOSHASHI site <noreply@noshashi.app>

# Optional second copy: Slack, Zapier, Make, a sheet — anything that
# accepts a JSON POST. Independent of the email channel.
# CONTACT_WEBHOOK_URL=https://hooks.example.com/...

# ─────────────────────────────────────────────────────────────────────
# Product update list
# ─────────────────────────────────────────────────────────────────────
#
# Subscribers are stored in a Resend Audience, not a database — the site
# has no server-side state anywhere else, and a subscribers table would
# be the first, with a retention question and a breach surface attached,
# to hold what Resend already holds with unsubscribe handling built in.
#
# Create an Audience in Resend, paste its ID here. Until it is set,
# /api/subscribe returns 503 and says so rather than accepting an
# address it has nowhere to put. /api/contact-status reports it.
#
# To send: add the entry to site/data/updates.json, deploy, then
#   node scripts/send-update.mjs --headline "v0.4.0 is out"          # dry run
#   node scripts/send-update.mjs --headline "v0.4.0 is out" --send
RESEND_AUDIENCE_ID=aud_replace_in_vercel

# ─────────────────────────────────────────────────────────────────────
# Optional website extras
# ─────────────────────────────────────────────────────────────────────
#
# With a key, /api/support-chat answers with Claude, grounded in
# api/_lib/kb.js. Without one it answers from the same knowledge base by
# retrieval — the widget works either way and never invents a figure.
# ANTHROPIC_API_KEY=sk-ant-...

# Raises GitHub's unauthenticated 60/hour API limit for the release and
# mission-log feeds. Only ever needs public read scope.
# GITHUB_TOKEN=ghp_...
