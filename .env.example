# Copy to .env.local to point a local build at a different Supabase project.
#
# Both are optional. src/lib/supabase/client.ts falls back to the production
# project when they are unset, which is what release builds depend on — the
# release workflow supplies neither, so removing that fallback would break
# every packaged build.
#
# The publishable key is not a secret. It grants nothing on its own: every
# table is behind row level security, and the service-role key that would
# bypass it exists only inside Edge Functions. The service-role key must never
# appear in this file or anywhere else in this repository.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Changing VITE_SUPABASE_URL is not enough on its own.
#
# The Tauri Content Security Policy allowlists the Supabase origin explicitly,
# in both src-tauri/tauri.conf.json and src-tauri/tauri.demo.conf.json, once
# over https and once over wss. That policy is compiled into the installer, so
# a new origin here without matching edits there works in `npm run tauri:dev`
# and blocks every request in the built application.
#
# src/lib/supabase/__tests__/client-csp.test.ts fails when the three disagree.

# "demo" builds the limited early-release artefact. See src/lib/edition.ts.
# VITE_NOSHASHI_EDITION=demo
