# Ignoshashi Production Configuration Template
# Copy this to .env and fill in your values

# Environment
NODE_ENV=production
PORT=3000
DATA_DIR=/data

# Chain
CHAIN_ENV=mainnet
ENABLE_REAL_CHAIN=true

# Platform Fee (2%)
PLATFORM_FEE_PERCENT=2
PLATFORM_FEE_ETH=0x...
PLATFORM_FEE_SOLANA=...

# Optional RPC overrides
# ETH_MAINNET_RPC=https://...
# SOLANA_MAINNET_RPC=https://...

# CORS (comma-separated)
ALLOWED_ORIGIN=https://yourdomain.com

# Optional: CoinGecko API key for price feeds
# COINMARKETCAP_API_KEY=your_key

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_ACCOUNT_ID is OPTIONAL — only needed if using Stripe Connect
# Without it, fees go to the account associated with your STRIPE_SECRET_KEY
# STRIPE_CONNECT_ACCOUNT_ID=acct_...
