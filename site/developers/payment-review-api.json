          },
          "403": {
            "description": "Insufficient scope or MFA required"
          },
          "409": {
            "description": "Idempotency payload conflict"
          },
          "429": {
            "description": "Processing capacity or request rate exceeded"
          },
          "503": {
            "description": "Unavailable; no passing result inferred"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
