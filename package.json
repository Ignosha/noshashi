{
  "name": "noshashi",
  "private": true,
  "version": "1.0.6",
  "description": "NOSHASHI institutional XRPL intelligence and data infrastructure",
  "main": "main.js",
  "author": "Ignoshashi",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "server": "node server.js",
    "electron": "electron .",
    "desktop": "electron .",
    "app": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pm2:start": "pm2 start server.js --name ignoshashi --watch",
    "pm2:stop": "pm2 stop ignoshashi",
    "pm2:restart": "pm2 restart ignoshashi",
    "pm2:logs": "pm2 logs ignoshashi",
    "vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "site:build": "node scripts/build-site.mjs",
    "site:dev": "node scripts/build-site.mjs && node scripts/dev-site.mjs",
    "email:preview": "node scripts/send-update.mjs --headline \"Preview\" || true",
    "email:send": "node scripts/send-update.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon": "tauri icon app-icon-master.png",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo --emptyOutDir",
    "tauri:demo": "tauri build --config src-tauri/tauri.demo.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:functions": "cd supabase/functions && deno check */index.ts",
    "check:brand": "node scripts/gen-brand.mjs --check",
    "check:garden": "node scripts/build-garden-field.mjs --check"
  },
  "build": {
    "appId": "com.ignoshashi.terminal",
    "productName": "Ignoshashi",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**",
      "node_modules/usb/**",
      "node_modules/bindings/**",
      "node_modules/node-gyp-build/**",
      "node_modules/bufferutil/**",
      "node_modules/utf-8-validate/**",
      "node_modules/blake-hash/**",
      "node_modules/tiny-secp256k1/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "package.json",
      "contracts/**/*",
      "public/**/*",
      ".env",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "contracts",
        "to": "contracts"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "app-icon-master.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app-icon-master.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Finance",
      "icon": "app-icon-master.png"
    }
  },
  "dependencies": {
    "@metamask/sdk": "^0.34.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-positioner": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "2.11.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/web3wallet": "^1.16.1",
    "asciify-engine": "^4.1.0",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "framer-motion": "^11.15.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solc": "^0.8.36",
    "stripe": "^14.25.0",
    "tailwind-merge": "^2.6.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "~5.6.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
